# Use a Supabase publishable key for browser access. Do not expose service_role/secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional but recommended in production so magic links always return to the canonical app URL.
# Example: https://movement-science-lab.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: self-host/pin MediaPipe runtime assets instead of using the defaults below.
# The default URLs remain the pinned @mediapipe/tasks-vision 1.0.1 WASM bundle and
# Google's full float16 Pose Landmarker model.
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=
NEXT_PUBLIC_MEDIAPIPE_MODEL_URL=
